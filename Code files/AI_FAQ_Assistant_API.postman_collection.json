            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is AI?\",\n  \"answer\": \"AI enables systems to perform tasks associated with human intelligence.\",\n  \"category\": \"Technology\",\n  \"tags\": [\n    \"ai\",\n    \"intelligence\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b=pm.response.json();",
                  "if(b.success&&b.data?._id)pm.collectionVariables.set(\"faqId\",b.data._id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get FAQs - Pagination + Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/faqs?page=1&limit=5&category=Technology",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "faqs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "category",
                  "value": "Technology"
                }
              ]
            }
          }
        },
